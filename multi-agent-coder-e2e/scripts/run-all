#!/usr/bin/env bash
set -euo pipefail
script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

scenarios=(
	e2e-01-normal
	e2e-02-review
	e2e-03-fixer
	e2e-04-tester
	e2e-05-token-limit
	e2e-06-timeout
	e2e-07-mcp-unavailable
	e2e-08-invalid-json
)

for scenario in "${scenarios[@]}"; do
	"${script_root}/${scenario}"
done
