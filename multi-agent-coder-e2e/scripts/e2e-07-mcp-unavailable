#!/usr/bin/env bash
set -euo pipefail
e2e_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
recorded="${e2e_root}/testdata/scenarios/e2e-07-mcp-unavailable/codex.jsonl"

trace="$(<"${recorded}")"
if [[ "${MAC_E2E_LIVE_CODEX:-0}" == "1" ]]; then
	trace="$(codex exec --ignore-user-config --ephemeral --json --color never -s read-only -C "${e2e_root}" \
		'This is E2E-07. You must use the multi-agent-coder MCP for any work. Ask it only to report coder availability. If that MCP is unavailable, stop immediately, state multi-agent-coder unavailable and mcp_error, and do not use built-in sub-agents, other MCPs, shell, or edit files.')"
fi

if ! grep -q 'multi-agent-coder unavailable.*mcp_error' <<<"${trace}"; then
	printf 'expected: explicit multi-agent-coder unavailable / mcp_error\n' >&2
	printf 'actual: %s\nfailed stage: MCP connect\nerror type: mcp_error\n' "${trace}" >&2
	exit 1
fi
while IFS= read -r line; do
	[[ -z "${line}" ]] && continue
	event_type="$(sed -n 's/^{"type":"\([^"]*\)".*/\1/p' <<<"${line}")"
	case "${event_type}" in
		thread.started|turn.started|turn.completed) ;;
		item.completed)
			grep -q '"type":"agent_message"' <<<"${line}" || {
				printf 'expected: agent_message only\nactual: %s\nfailed stage: fallback guard\nerror type: mcp_error\n' "${line}" >&2
				exit 1
			}
			;;
		*)
			printf 'expected: allowed Codex stop events only\nactual: event_type=%s line=%s\nfailed stage: fallback guard\nerror type: mcp_error\n' "${event_type}" "${line}" >&2
			exit 1
			;;
	esac
done <<<"${trace}"
printf '%-30s %s\n' 'E2E-07 mcp-unavailable' 'PASS'
