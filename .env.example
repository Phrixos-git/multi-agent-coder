# Local llama-server endpoint. Keep it bound to loopback by default.
MAC_LLM_BASE_URL=http://127.0.0.1:8080

# Optional model name. Leave empty to use the llama-server configuration.
MAC_LLM_MODEL=

# LLM request timeout as a Go duration.
MAC_LLM_TIMEOUT=120s

# Repository that local agents may read. Relative paths are resolved at startup.
MAC_REPOSITORY_ROOT=.

# Supported values: debug, info, warn, error.
MAC_LOG_LEVEL=info
