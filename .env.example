# Repository that agents may read; Pi additionally creates a temporary worktree here. Relative paths resolve at startup.
MAC_REPOSITORY_ROOT=.

# Main LLM used by reviewer and tester.
# Keep local llama-server endpoints bound to loopback by default.
MAC_LLM_BASE_URL=http://127.0.0.1:8089

# Model ID served by the Main LLM.
MAC_LLM_MODEL=qwen3.8-27b

# LLM request timeout as a Go duration.
MAC_LLM_TIMEOUT=180s

# Coding LLM used by coder and fixer.
MAC_CODING_LLM_BASE_URL=http://127.0.0.1:8089
MAC_CODING_LLM_MODEL=qwen-coder
MAC_CODING_LLM_TIMEOUT=180s

# Completion token limits. Role-specific values apply to agent requests.
MAC_LLM_MAX_TOKENS=4096
MAC_CODER_MAX_TOKENS=4096
MAC_REVIEWER_MAX_TOKENS=4096
MAC_TESTER_MAX_TOKENS=3072
MAC_FIXER_MAX_TOKENS=4096

# Direct LLM generation settings.
MAC_LLM_REASONING_EFFORT=none
MAC_LLM_TEMPERATURE=0.2

# Supported values: debug, info, warn, error.
MAC_LOG_LEVEL=info

# Coder backend: direct (default) or pi.
MAC_CODER_BACKEND=direct
# Fixer backend: direct (default) or pi.
MAC_FIXER_BACKEND=direct
# Shared Pi settings used whenever coder or fixer selects Pi.
MAC_PI_EXECUTABLE=pi
MAC_PI_PROVIDER=local-qwen
MAC_PI_MODEL=qwen
MAC_PI_AGENT_DIR=
MAC_PI_RPC_ARGS=
# 0 means unlimited Pi agent runtime; startup and RPC idle guards remain active.
MAC_PI_TIMEOUT=0

# Optional: used only by scripts/run-mcp-server.
# MAC_LOG_DIR=/absolute/path/to/log-directory
