#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Select model profile
if [[ $# -ne 1 ]]; then
    printf 'Usage: %s {qwen|strata}\n' "$0" >&2
    exit 2
fi

profile="$1"

case "${profile}" in
    qwen)
        env_file="${repository_root}/.env.qwen"
        ;;
    strata)
        env_file="${repository_root}/.env.strata"
        ;;
    *)
        printf 'Unknown MAC profile: %s\n' "${profile}" >&2
        exit 2
        ;;
esac

# Load environment configuration
if [[ ! -f "${env_file}" ]]; then
    printf 'MAC env file not found: %s\n' "${env_file}" >&2
    exit 1
fi

umask 077

set -a
source "${env_file}"
set +a

# Locate MAC executable
server_binary="${repository_root}/multi-agent-coder"

if [[ ! -x "${server_binary}" ]]; then
    server_binary="${repository_root}/bin/multi-agent-coder"
fi

# Configure logging
log_directory="${MAC_LOG_DIR:-${repository_root}/logs}"

mkdir -p -- "${log_directory}"

log_file="${log_directory}/multi-agent-coder-${profile}-$(date +%F).log"

# Keep stdout exclusively for MCP protocol traffic.
# Save stderr to file and forward it to Codex.
exec 3>&2
exec 2> >(tee -a -- "${log_file}" >&3)

if [[ ! -x "${server_binary}" ]]; then
    printf 'multi-agent-coder executable not found or not executable: %s\n' \
        "${server_binary}" >&2
    exit 1
fi

exec "${server_binary}"
