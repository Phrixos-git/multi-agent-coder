#!/usr/bin/env bash

set -euo pipefail

install_directory="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
launch_directory="$(pwd -P)"
client_project_directory="${CLAUDE_PROJECT_DIR-}"

usage() {
    printf 'Usage: %s {qwen|strata} [codex|claude-code] [--workspace-from-cwd]\n' "$0" >&2
}

# Select model profile and MCP client (orchestrator)
if [[ $# -lt 1 || $# -gt 3 ]]; then
    usage
    exit 2
fi

profile="$1"
orchestrator="${2:-codex}"
server_args=()
if [[ $# -eq 3 ]]; then
    if [[ "$3" != --workspace-from-cwd ]]; then
        usage
        exit 2
    fi
    server_args=("$3")
fi

case "${orchestrator}" in
    codex|claude-code)
        ;;
    *)
        usage
        exit 2
        ;;
esac

case "${profile}" in
    qwen)
        env_file="${install_directory}/.env.qwen"
        ;;
    strata)
        env_file="${install_directory}/.env.strata"
        ;;
    *)
        printf 'Unknown MAC profile: %s\n' "${profile}" >&2
        exit 2
        ;;
esac

# Load environment configuration
if [[ ! -f "${env_file}" ]]; then
    printf 'MAC env file not found: %s\n' "${env_file}" >&2
    exit 1
fi

umask 077

set -a
source "${env_file}" >&2
set +a

# Preserve the client and workspace information across profile loading.
export MAC_ORCHESTRATOR="${orchestrator}"
export CLAUDE_PROJECT_DIR="${client_project_directory}"
cd -- "${launch_directory}"

# Locate MAC executable
server_binary="${install_directory}/multi-agent-coder"

if [[ ! -x "${server_binary}" ]]; then
    server_binary="${install_directory}/bin/multi-agent-coder"
fi

# Configure logging
log_directory="${MAC_LOG_DIR:-${install_directory}/logs}"

mkdir -p -- "${log_directory}"

log_file="${log_directory}/multi-agent-coder-${profile}-$(date +%F).log"

# Keep stdout exclusively for MCP protocol traffic.
# Save stderr to file and forward it to the MCP client.
exec 3>&2
exec 2> >(tee -a -- "${log_file}" >&3)

if [[ ! -x "${server_binary}" ]]; then
    printf 'multi-agent-coder executable not found or not executable: %s\n' \
        "${server_binary}" >&2
    exit 1
fi

exec "${server_binary}" "${server_args[@]}"
